  }
  .w-tabs[hidden],
  .w-switch[hidden] { display: none; }
  .w-tabs button {
    padding: 0.3rem 0.9rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    background: transparent;
    cursor: pointer;
    transition: background 0.3s var(--w-ease), color 0.3s var(--w-ease);
  }
  .w-tabs button[aria-selected='true'] {
    color: var(--sl-color-text-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }
  .w-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.4rem;
    border: 0;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    background: transparent;
    cursor: pointer;
  }
  .w-switch-track {
    position: relative;
    width: 2.1rem;
    height: 1.2rem;
    border-radius: 999px;
