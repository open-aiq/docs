<script>
  const KEY = 'oa-wiring-layout'
  const DIRECT = 'oa-wiring-direct'
  type Layout = 'breadboard' | 'proto2'

  for (const fig of document.querySelectorAll<HTMLElement>('[data-wiring]')) {
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const scenes = [...fig.querySelectorAll<HTMLElement>('.w-scene')]
    const cards = [...fig.querySelectorAll<HTMLElement>('.w-card')]
    const toggle = fig.querySelector<HTMLButtonElement>('.w-toggle')!
    const sw = fig.querySelector<HTMLButtonElement>('.w-switch')!
    const bbScene = fig.querySelector<HTMLElement>('#wd-scene-breadboard')!
    const bbSvg = bbScene.querySelector('svg')!
    let layout: Layout = 'breadboard'
    let direct = false
    try {
      const saved = localStorage.getItem(KEY)
      if (saved === 'breadboard' || saved === 'proto2') layout = saved
      direct = localStorage.getItem(DIRECT) === '1'
    } catch {}
    let pinned = `overview-${layout}`

    const bases = new Set([...fig.querySelectorAll<SVGGElement>('[data-base]')].map((b) => b.dataset.id))
    const hits = () => [...fig.querySelectorAll<SVGGElement>(`.w-scene[data-layout="${layout}"] .w-hit`)]
    const show = (id: string) => {
      // The bare board shows its card without dimming the parts on it.
      fig.classList.toggle('has-active', !id.startsWith('overview') && !bases.has(id))
      for (const h of hits()) {
        h.classList.toggle('is-active', h.dataset.ids!.split(' ').includes(id))
        h.setAttribute('aria-pressed', String(h.dataset.id === id && pinned === id))
      }
      for (const c of cards) c.classList.toggle('is-active', c.dataset.id === id)
    }

    const setDirect = (on: boolean) => {
      direct = on
      bbScene.classList.toggle('is-direct', on)
      // Without the boards, crop the empty space they leave above the devkit.
      bbSvg.setAttribute('viewBox', on ? '-100 124 812 696' : '-100 -24 812 844')
      sw.setAttribute('aria-pressed', String(on))
      if (pinned === 'breadboard') pinned = `overview-${layout}`
      show(pinned)
      try {
        localStorage.setItem(DIRECT, on ? '1' : '0')
      } catch {}
    }

    const setLayout = (next: Layout, focus = false) => {
      layout = next
      for (const t of tabs) {
        const on = t.dataset.layout === next
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        if (on && focus) t.focus()
      }
      for (const s of scenes) s.hidden = s.dataset.layout !== next
      for (const c of cards) c.classList.toggle('is-other', !c.dataset.layouts!.split(' ').includes(next))
      sw.hidden = next !== 'breadboard'
      pinned = `overview-${next}`
      show(pinned)
      try {
        localStorage.setItem(KEY, next)
      } catch {}
    }

    for (const h of fig.querySelectorAll<SVGGElement>('.w-hit')) {
      const id = h.dataset.id!
      h.addEventListener('focus', () => show(id))
      h.addEventListener('blur', () => show(pinned))
      h.addEventListener('click', (e) => {
        e.stopPropagation()
        pinned = pinned === id ? `overview-${layout}` : id
        show(pinned)
      })
      h.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          h.dispatchEvent(new MouseEvent('click'))
        }
      })
    }
    for (const svg of fig.querySelectorAll<SVGSVGElement>('.w-scene svg')) {
      // Over a wire or part, trace it; over the bare board or a gap, show everything again.
      svg.addEventListener('pointerover', (e) => {
        if (e.pointerType !== 'mouse') return
        const h = (e.target as Element).closest<SVGGElement>('.w-hit')
        show(h && !('base' in h.dataset) ? h.dataset.id! : pinned)
      })
      svg.addEventListener('pointerleave', () => show(pinned))
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => setLayout(t.dataset.layout as Layout))
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (!step) return
        e.preventDefault()
        setLayout(tabs[(i + step + tabs.length) % tabs.length].dataset.layout as Layout, true)
      })
    })
    sw.addEventListener('click', () => setDirect(!direct))

    toggle.hidden = false
    toggle.addEventListener('click', () => {
      const all = !fig.classList.contains('is-all')
      fig.classList.toggle('is-all', all)
      toggle.setAttribute('aria-expanded', String(all))
      toggle.textContent = all ? 'Show less' : 'Show all details'
    })

    fig.querySelector<HTMLElement>('.w-tabs')!.hidden = false
    fig.classList.add('is-ready')
    setLayout(layout)
    setDirect(direct)
  }
</script>

