---
// How to wire the monitor, drawn like a tutorial rather than a schematic, in
// realistic colours so it matches the parts on your desk.
//
// Two layouts share one set of cards. The breadboard build spans two boards,
// because the DevKitC-1's headers are 25.4 mm apart, too wide for one; a
// switch hides the boards and shows the same parts wired directly. The Proto2
// view shows the carrier with simplified traces (not the real routing).
//
// Every wire, trace and part is a button. Hovering, tapping or focusing one
// highlights it, with the parts it touches, and shows its card below. Without
// JavaScript both layouts and every card are listed. Pins come from
// src/data/wiring.ts, so the drawing and the page's pin table agree.
import { cards, leftHeader, rightHeader, netPin, type Card, type Layout, type NetId } from '../data/wiring'

type Pt = [number, number]
type Seg = { d: string; a: Pt; b: Pt }
type Net = { id: NetId; segs: Seg[]; joins?: Pt[] }

const byId = Object.fromEntries(cards.map((c) => [c.id, c])) as Record<string, Card>
const f = (n: number) => Math.round(n * 10) / 10

const line = (x1: number, y1: number, x2: number, y2: number): Seg => ({ d: `M${x1},${y1} L${x2},${y2}`, a: [x1, y1], b: [x2, y2] })
const curve = (d: string, a: Pt, b: Pt): Seg => ({ d, a, b })
// A tidy route: straight runs with softly rounded corners.
const ortho = (pts: Pt[], r = 6): Seg => {
  let d = `M${pts[0][0]},${pts[0][1]}`
  for (let i = 1; i < pts.length - 1; i++) {
    const [x0, y0] = pts[i - 1]
    const [x1, y1] = pts[i]
    const [x2, y2] = pts[i + 1]
    const l1 = Math.hypot(x1 - x0, y1 - y0)
    const l2 = Math.hypot(x2 - x1, y2 - y1)
    const rr = Math.min(r, l1 / 2, l2 / 2)
    d += ` L${f(x1 - ((x1 - x0) / l1) * rr)},${f(y1 - ((y1 - y0) / l1) * rr)} Q${x1},${y1} ${f(x1 + ((x2 - x1) / l2) * rr)},${f(y1 + ((y2 - y1) / l2) * rr)}`
  }
  const last = pts[pts.length - 1]
  return { d: `${d} L${last[0]},${last[1]}`, a: pts[0], b: last }
}

const tone: Record<NetId, string> = {
  v5: 'v5', v3: 'v3', gnd: 'gnd', sda: 'sda', scl: 'scl', tx: 'tx', rx: 'rx',
  set: 'ctl', reset: 'ctl', left: 'btn', right: 'btn', pair: 'btn',
}

// ---------- Breadboard ----------
// Two boards, top to bottom:
//   strip:   rails (cut from board 1's bottom edge)
//   board 1: rails | 5 rows | channel | 5 rows
//   board 2: rails | 5 rows | channel | 5 rows | rails
// The devkit lies across the seam, antenna left and USB right. Its signal
// header sits in board 1's lowest row, which leaves four free holes above
// every pin; its other header lands ten rows down, in board 2. Board 1's
// bottom rails would sit under the devkit, so they're cut off and moved to
// the top, where they carry the I²C bus. (All of this is before the flip
// below, so on screen board 1 is the lower board.)
const P = 16
// Drawn the other way up, then flipped so the devkit matches the real board:
// antenna left, both USB ports right and the signal header along the bottom.
// Everything below the flip uses the unflipped coordinates; text is turned
// back upright around its own middle (h is roughly its glyph height).
const FLIP = 796
const up = (y: number, h: number) => `matrix(1 0 0 -1 0 ${2 * y - h})`
const row = (n: number) => 248 + n * P
const bbCols = Array.from({ length: 40 }, (_, c) => 56 + c * P)
const holeRows = [3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 20, 21, 22, 23, 24, 27, 28, 29, 30, 31].map(row)
const railRows = [-3, -2, 0, 1, 17, 18, 33, 34].map(row)
const hole = (x: number, y: number) => `M${x - 2.4},${y - 2.4}h4.8v4.8h-4.8z`
const bbHoles = [
  ...holeRows.flatMap((y) => bbCols.map((x) => hole(x, y))),
  ...railRows.flatMap((y) => bbCols.filter((_, c) => c % 6 !== 3).map((x) => hole(x, y))),
].join('')

const X = (name: string) => 216 + leftHeader.indexOf(name) * P
const xp = (net: NetId) => X(netPin[net])
const TOP = row(14) // the signal header
const BOT = row(24) // the other header
const rail = { scl: row(-3), sda: row(-2), v3: row(0), gnd: row(1) }

// Parts and their pins. The OLED and PMS5003 hang above the boards, lifted
// clear of the I²C strip (UP); the PMS5003's pins sit over the columns they
// feed and the OLED's over free rail holes. The SHT30 sits to the left, away
// from the devkit's warmth; the buttons plug into board 1.
const UP = 48
const OLED_DX = -96
const oled = { y: 212 - UP, gnd: 136, v3: 152, scl: 168, sda: 184 }
const pms = { y: 212 - UP, reset: 344, rx: 360, tx: 376, set: 392, gnd: 408, v5: 424 }
const pmsLabels: [number, string][] = [[pms.reset, 'RST'], [pms.rx, 'TX'], [pms.tx, 'RX'], [pms.set, 'SET'], [pms.gnd, 'GND'], [pms.v5, 'VCC']]
const sht = { x: -12, v3: 384, gnd: 400, scl: 416, sda: 432 }
// Where each SHT30 wire meets its rail, left to right so the wires nest.
const shtAt = { v3: 56, gnd: 72, scl: 88, sda: 120 }
const bbButtons: { id: NetId; sig: number; gnd: number }[] = [
  { id: 'left', sig: xp('left'), gnd: xp('left') + P },
  { id: 'right', sig: xp('right'), gnd: xp('right') + P },
]
const legY = row(5)

// Out to the right, then up into the rail: lower pins reach further right, so
// the four wires nest without crossing.
const shtWire = (net: 'v3' | 'gnd' | 'scl' | 'sda') => {
  const y = sht[net]
  const x = shtAt[net]
  const to: Pt = [x, rail[net]]
  return curve(`M${sht.x},${y} C${x - 32},${y} ${x},${y - 84} ${x},${to[1]}`, [sht.x, y], to)
}

// Every I²C part drops into the strip at the top, and the devkit's SDA and
// SCL each send one wire up to it.
const bbNets: Net[] = [
  {
    id: 'gnd',
    segs: [
      line(oled.gnd, oled.y, oled.gnd, rail.gnd),
      line(pms.gnd, pms.y, pms.gnd, rail.gnd),
      line(X('GND'), row(10), X('GND'), rail.gnd),
      ...bbButtons.map((b) => line(b.gnd, row(3), b.gnd, rail.gnd)),
      shtWire('gnd'),
    ],
  },
  {
    id: 'v3',
    segs: [line(oled.v3, oled.y, oled.v3, rail.v3), line(X('3V3'), row(10), X('3V3'), rail.v3), shtWire('v3')],
  },
  { id: 'v5', segs: [curve(`M${pms.v5},${pms.y} C${pms.v5},330 ${xp('v5')},330 ${xp('v5')},${row(11)}`, [pms.v5, pms.y], [xp('v5'), row(11)])] },
  { id: 'set', segs: [line(pms.set, pms.y, xp('set'), row(11))] },
  { id: 'reset', segs: [line(pms.reset, pms.y, xp('reset'), row(11))] },
  { id: 'tx', segs: [line(pms.tx, pms.y, xp('tx'), row(11))] },
  { id: 'rx', segs: [line(pms.rx, pms.y, xp('rx'), row(11))] },
  ...bbButtons.map((b): Net => ({ id: b.id, segs: [line(b.sig, row(7), b.sig, row(10))] })),
  { id: 'scl', segs: [line(oled.scl, oled.y, oled.scl, rail.scl), line(xp('scl'), row(10), xp('scl'), rail.scl), shtWire('scl')] },
  { id: 'sda', segs: [line(oled.sda, oled.y, oled.sda, rail.sda), line(xp('sda'), row(10), xp('sda'), rail.sda), shtWire('sda')] },
]

// The same parts with no breadboard: wires run straight to the header pins.
// Bare wires stand in for the rails: SCL, SDA, 3.3 V and ground.
// A bare line from the SHT30's end to the devkit pin's column, with parts
// dropping onto it from [x, y].
const bus = (net: 'v3' | 'gnd' | 'scl' | 'sda', to: number, drops: Pt[]): Net => ({
  id: net,
  segs: [
    line(shtAt[net], rail[net], to, rail[net]),
    line(to, rail[net], to, TOP),
    ...drops.map(([x, y]) => line(x, y, x, rail[net])),
    shtWire(net),
  ],
  joins: drops.map(([x]): Pt => [x, rail[net]]),
})
const dNets: Net[] = [
  bus('gnd', X('GND'), [[oled.gnd, oled.y], [pms.gnd, pms.y], ...bbButtons.map((b): Pt => [b.gnd, legY])]),
  bus('v3', X('3V3'), [[oled.v3, oled.y]]),
  { id: 'v5', segs: [ortho([[pms.v5, pms.y], [pms.v5, 300], [xp('v5'), 300], [xp('v5'), TOP]], 10)] },
  { id: 'set', segs: [line(pms.set, pms.y, xp('set'), TOP)] },
  { id: 'reset', segs: [line(pms.reset, pms.y, xp('reset'), TOP)] },
  { id: 'tx', segs: [line(pms.tx, pms.y, xp('tx'), TOP)] },
  { id: 'rx', segs: [line(pms.rx, pms.y, xp('rx'), TOP)] },
  ...bbButtons.map((b): Net => ({ id: b.id, segs: [line(b.sig, legY, b.sig, TOP)] })),
  bus('scl', xp('scl'), [[oled.scl, oled.y]]),
  bus('sda', xp('sda'), [[oled.sda, oled.y]]),
]
const bbLabels = [...new Set(bbNets.map((n) => netPin[n.id]))]

const fan = { x: 404, y: 100 }
const blades = [0, 1, 2, 3, 4, 5, 6].map((i) => {
  const a = (i * 2 * Math.PI) / 7
  const p = (r: number, da: number) => `${f(fan.x + r * Math.cos(a + da))},${f(fan.y + r * Math.sin(a + da))}`
  return `M${p(9, 0)} Q${p(24, 0.5)} ${p(36, 1)}`
})

// ---------- Proto2 ----------
// Positions follow the rev C board (hardware/pcb/proto2): OLED top-left with
// the buttons under it, the PMS5003 bed in the middle, SHT30 below it and the
// devkit on the right with its USB at the bottom.
const LX = 693
const py = (name: string) => f(50 + leftHeader.indexOf(name) * 15.7)
const pn = (net: NetId) => py(netPin[net])
const j1 = (pin: number) => f(233 - (pin - 1) * 8.2) // J1 pin 1 (VCC) is at the bottom
const hop = (y1: number, y2: number): Seg => curve(`M658,${y1} C676,${y1} 676,${y2} ${LX},${y2}`, [658, y1], [LX, y2])
const j2 = { y: 52, gnd: 174, v3: 190, scl: 206, sda: 222 }
const j3 = { y: 378, v3: 350, gnd: 366, scl: 382, sda: 398 }
const buttons: { id: NetId; x: number; label: string }[] = [
  { id: 'left', x: 116, label: 'LEFT' },
  { id: 'pair', x: 196, label: 'PAIR' },
  { id: 'right', x: 276, label: 'RIGHT' },
]

const p2Nets: Net[] = [
  {
    id: 'gnd',
    segs: [
      ortho([[LX, py('GND')], [682, py('GND')], [682, 400], [92, 400], [92, 62], [j2.gnd, 62], [j2.gnd, j2.y]]),
      ortho([[658, j1(2)], [645, j1(2)], [645, 400]]),
      ...buttons.map((b) => line(b.x - 13, 315, b.x - 13, 400)),
      line(j3.gnd, j3.y, j3.gnd, 400),
    ],
  },
  {
    id: 'v3',
    segs: [
      ortho([[LX, py('3V3')], [680, py('3V3')], [680, 36], [76, 36], [76, 410], [j3.v3, 410], [j3.v3, j3.y]]),
      line(j2.v3, 36, j2.v3, j2.y),
    ],
  },
  { id: 'v5', segs: [ortho([[658, j1(1)], [676, j1(1)], [676, pn('v5')], [LX, pn('v5')]])] },
  { id: 'reset', segs: [hop(j1(6), pn('reset'))] },
  { id: 'rx', segs: [hop(j1(5), pn('rx'))] },
  { id: 'tx', segs: [hop(j1(4), pn('tx'))] },
  { id: 'set', segs: [hop(j1(3), pn('set'))] },
  ...buttons.map((b, i): Net => ({
    id: b.id,
    segs: [ortho([[b.x + 13, 289], [b.x + 13, 266 + i * 8], [336 + i * 10, 266 + i * 8], [336 + i * 10, pn(b.id)], [LX, pn(b.id)]])],
  })),
  {
    id: 'sda',
    segs: [ortho([[j2.sda, j2.y], [j2.sda, pn('sda')], [LX, pn('sda')]]), line(j3.sda, j3.y, j3.sda, pn('sda'))],
  },
  {
    id: 'scl',
    segs: [ortho([[j2.scl, j2.y], [j2.scl, 44], [250, 44], [250, pn('scl')], [LX, pn('scl')]]), line(j3.scl, j3.y, j3.scl, pn('scl'))],
  },
]
const p2Labels = [...new Set(p2Nets.map((n) => netPin[n.id]))]

// ---------- Hit targets ----------
const touches: Record<Layout, Partial<Record<NetId, string[]>>> = {
  breadboard: {
    v5: ['devkit', 'pms'], v3: ['devkit', 'oled', 'sht'], gnd: ['devkit', 'pms', 'oled', 'sht', 'left', 'right'],
    sda: ['devkit', 'oled', 'sht'], scl: ['devkit', 'oled', 'sht'],
    tx: ['devkit', 'pms'], rx: ['devkit', 'pms'], set: ['devkit', 'pms'], reset: ['devkit', 'pms'],
    left: ['devkit'], right: ['devkit'],
  },
  proto2: {
    v5: ['devkit', 'pms', 'caps'], v3: ['devkit', 'oled', 'sht', 'pullups-i2c', 'pullups-pms', 'caps'],
    gnd: ['devkit', 'pms', 'oled', 'sht', 'left', 'right', 'pair', 'caps'],
    sda: ['devkit', 'oled', 'sht', 'pullups-i2c'], scl: ['devkit', 'oled', 'sht', 'pullups-i2c'],
    tx: ['devkit', 'pms'], rx: ['devkit', 'pms'], set: ['devkit', 'pms', 'pullups-pms'], reset: ['devkit', 'pms', 'pullups-pms'],
    left: ['devkit'], right: ['devkit'], pair: ['devkit'],
  },
}
// A net lights up the parts it touches, and a part lights up its nets.
const related = (layout: Layout, id: string, part: boolean) => {
  const t = touches[layout]
  if (!part) return t[id as NetId] ?? []
  return Object.entries(t).filter(([, parts]) => parts!.includes(id)).map(([net]) => net)
}
const hit = (
  layout: Layout,
  id: string,
  opts: { base?: boolean; part?: boolean; extra?: string } = {},
): astroHTML.JSX.SVGAttributes & Record<`data-${string}`, string | undefined> => ({
  class: ['w-hit', opts.base && 'w-base', opts.extra].filter(Boolean).join(' '),
  'data-id': id,
  'data-ids': [id, ...(opts.base ? [] : related(layout, id, !!opts.part))].join(' '),
  'data-base': opts.base ? '' : undefined,
  role: 'button',
  tabindex: 0,
  'aria-label': byId[id].title,
  'aria-controls': `wd-card-${id}`,
  'aria-pressed': 'false',
})
const ends = (n: Net) => [...new Map(n.segs.flatMap((s) => [s.a, s.b]).map((p) => [p.join(','), p])).values()]
const resistor = (x1: number, y1: number, x2: number, y2: number) => {
  const vertical = x1 === x2
  const cx = (x1 + x2) / 2
  const cy = (y1 + y2) / 2
  return { lead: `M${x1},${y1} L${x2},${y2}`, body: vertical ? { x: cx - 4.5, y: cy - 13, w: 9, h: 26 } : { x: cx - 13, y: cy - 4.5, w: 26, h: 9 }, cx, cy }
}
const r1 = resistor(468, 349, 528, 349)
const r2 = resistor(468, 370, 528, 370)
const r3 = resistor(652, 46, 652, 86)
const r4 = resistor(670, 46, 670, 86)
const layoutCards = (c: Card) => (c.layouts ?? ['breadboard', 'proto2']).join(' ')
---

<figure class="wd not-content" data-wiring>
  <div class="w-bar">
    <div class="w-tabs" role="tablist" aria-label="Choose a build" hidden>
      <button type="button" role="tab" id="wd-tab-breadboard" aria-controls="wd-scene-breadboard" aria-selected="true" data-layout="breadboard">Breadboard</button>
      <button type="button" role="tab" id="wd-tab-proto2" aria-controls="wd-scene-proto2" aria-selected="false" tabindex="-1" data-layout="proto2">Proto2 board</button>
    </div>
    <button class="w-switch" type="button" aria-pressed="false" aria-controls="wd-scene-breadboard" hidden>
      <span class="w-switch-track" aria-hidden="true"><span class="w-switch-dot"></span></span>
      Hide breadboard
    </button>
  </div>

  <div class="w-scene" id="wd-scene-breadboard" role="tabpanel" aria-labelledby="wd-tab-breadboard" data-layout="breadboard">
    <p class="w-caption">Breadboard build</p>
    <svg viewBox="-100 -24 812 844" role="group" aria-label="Breadboard wiring: tap a wire or a part for details">
      <defs>
        <!-- Crossing gaps only where wires cross, never over the parts. -->
        <clipPath id="wd-gap-clip"><rect x="-6" y="182" width="700" height="276" /></clipPath>
      </defs>
      <rect class="w-mat w-bb-only" x="-100" y="-24" width="812" height="844" rx="18" />
      <rect class="w-mat w-direct-only" x="-100" y="124" width="812" height="696" rx="18" />

      <g class="w-flip" transform={`matrix(1 0 0 -1 0 ${FLIP})`}>

      <!-- Two breadboards, plus board 1's bottom rails cut off and moved to the top -->
      <g {...hit('breadboard', 'breadboard', { base: true, extra: 'w-bb-only' })}>
        <rect class="w-bb" x="40" y="186" width="656" height="44" rx="6" />
        <rect class="w-bb" x="40" y="236" width="656" height="252" rx="6" />
        <rect class="w-bb" x="40" y="494" width="656" height="318" rx="6" />
        <rect class="w-channel" x="40" y="377" width="656" height="14" />
        <rect class="w-channel" x="40" y="649" width="656" height="14" />
        <path class="w-rail is-plus" d={`M56,${row(-3) - 8} H680 M56,${row(0) - 8} H680 M56,${row(17) - 8} H680 M56,${row(34) + 8} H680`} />
        <path class="w-rail is-minus" d={`M56,${row(-2) + 8} H680 M56,${row(1) + 8} H680 M56,${row(18) + 8} H680 M56,${row(33) - 8} H680`} />
        <path class="w-holes" d={bbHoles} />
        {[[row(0), '+'], [row(1), '−'], [row(17), '+'], [row(18), '−'], [row(33), '−'], [row(34), '+']].map(([y, s]) => (
          <text class="w-label is-sign" x="47" y={Number(y) + 4} transform={up(Number(y) + 4, 8)}>{s}</text>
        ))}
        {[[rail.scl, 'SCL'], [rail.sda, 'SDA']].map(([y, s]) => (
          <text class="w-label is-sign is-end" x="34" y={Number(y) + 4} transform={up(Number(y) + 4, 9)}>{s}</text>
        ))}
      </g>

      <!-- Devkit across the seam -->
      <g {...hit('breadboard', 'devkit', { part: true })}>
        <ellipse class="w-shadow is-direct-only" cx="390" cy="452" rx="210" ry="8" />
        <rect class="w-pcb" x="180" y="462" width="396" height="180" rx="8" />
        <path class="w-antenna" d="M186,476 v148 M194,476 h0 M186,484 h12 v14 h-8 v14 h8 v14 h-8 v14 h8 v14 h-8 v14 h8 v14 h-8 v14 h8 v14 h-8 v14 h8" />
        <rect class="w-can" x="210" y="500" width="112" height="104" rx="5" />
        <rect class="w-can-inner" x="220" y="510" width="92" height="84" rx="3" />
        <rect class="w-usb" x="566" y="484" width="30" height="30" rx="6" />
        <rect class="w-usb" x="566" y="590" width="30" height="30" rx="6" />
        <rect class="w-tact" x="534" y="500" width="14" height="10" rx="2" />
        <rect class="w-tact" x="534" y="594" width="14" height="10" rx="2" />
        <circle class="w-led-halo" cx="508" cy="552" r="8" />
        <circle class="w-led" cx="508" cy="552" r="4" />
        {leftHeader.map((name) => <rect class="w-pin" x={X(name) - 3.5} y={TOP - 3.5} width="7" height="7" rx="1" />)}
        {rightHeader.map((_, i) => <rect class="w-pin" x={216 + i * P - 3.5} y={BOT - 3.5} width="7" height="7" rx="1" />)}
        {bbLabels.map((name) => <text class="w-label is-pcb" x={X(name)} y={TOP + 18} transform={up(TOP + 18, 7)}>{name}</text>)}
      </g>

      <!-- Buttons, plugged into board 1 -->
      {
        bbButtons.map((b) => (
          <g {...hit('breadboard', b.id, { part: true })}>
            <rect class="w-leg" x={b.sig - 2.5} y={legY - 2.5} width="5" height="5" />
            <rect class="w-leg" x={b.gnd - 2.5} y={legY - 2.5} width="5" height="5" />
            <rect class="w-btn" x={b.sig - 4} y={legY - 12} width="24" height="24" rx="3" />
            <circle class="w-cap" cx={b.sig + 8} cy={legY} r="7" />
          </g>
        ))
      }

      <!-- PMS5003 and its adapter -->
      <g {...hit('breadboard', 'pms', { part: true })}>
        <g transform={`translate(0,${-UP})`}>
          <ellipse class="w-shadow" cx="448" cy="26" rx="112" ry="6" />
          <rect class="w-metal" x="336" y="32" width="224" height="138" rx="8" />
          <circle class="w-grille" cx={fan.x} cy={fan.y} r="44" />
          {blades.map((d) => <path class="w-blade" d={d} />)}
          <circle class="w-hub" cx={fan.x} cy={fan.y} r="8" />
          {[56, 72, 88, 104, 120, 136].map((y) => <rect class="w-vent" x="470" y={y} width="72" height="7" rx="3.5" />)}
          <path class="w-cable" d="M520,170 C520,184 450,180 420,190" />
          <rect class="w-adapter" x="332" y="188" width="104" height="34" rx="4" />
        </g>
        {pmsLabels.map(([x]) => <rect class="w-pin" x={x - 3} y={pms.y - 3} width="6" height="6" rx="1" />)}
        {pmsLabels.map(([x, label]) => <text class="w-label is-mod is-small" x={x} y={pms.y - 10} transform={up(pms.y - 10, 6)}>{label}</text>)}
      </g>

      <!-- OLED -->
      <g {...hit('breadboard', 'oled', { part: true })}>
