  .w-switch[aria-pressed='true'] .w-switch-dot { transform: translateX(0.9rem); }
  .w-tabs button:focus-visible,
  .w-switch:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; border-radius: 999px; }

  /* Scenes scroll sideways on narrow screens rather than shrinking too far. */
  .w-scene { overflow-x: auto; }
  .w-scene[hidden] { display: none; }
  .w-scene + .w-scene { margin-top: 1rem; }
  .wd.is-ready .w-scene + .w-scene { margin-top: 0; }
  .w-caption {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .wd.is-ready .w-caption { display: none; }
  .w-scene svg {
