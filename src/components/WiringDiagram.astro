    --w-v5: #d7372b;
    --w-v3: #f28c1c;
    --w-gnd: #1e1e1e;
    --w-sda: #2f6fdb;
    --w-scl: #e2bd00;
    --w-tx: #2e9e47;
    --w-rx: #8e44ad;
    --w-ctl: #7d858d;
    --w-btn: #11a0a0;

    --w-card: color-mix(in srgb, var(--sl-color-gray-6) 45%, var(--sl-color-bg));
    --w-line: var(--sl-color-hairline);
    --w-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

    margin: 1.5rem 0 2.5rem;
