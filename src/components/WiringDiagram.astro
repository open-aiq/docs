    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 8% 12%, color-mix(in srgb, var(--sl-color-accent) 12%, transparent), transparent 42%),
      radial-gradient(circle at 95% 92%, color-mix(in srgb, var(--oa-sage, #6f7f5c) 12%, transparent), transparent 42%),
      var(--w-card);
    box-shadow: 0 1px 2px rgb(59 39 22 / 0.05), 0 10px 28px -14px rgb(59 39 22 / 0.24);
  }
  /* In dark mode the desk is dimmed a little, so it doesn't glare. */
