---
// The web dashboard's view inside a monitor: two columns of the same height.
// On the left, the AQI tile over particulates (3:1); on the right, how it
// feels over climate (2:2). The monitor's facts sit underneath as bubbles.
// Matches MonitorReadings in the dashboard's src/components/readings.jsx.
import AqiBlock from './AqiBlock.astro';
import DeviceFacts from './DeviceFacts.astro';
import Icon from './Icon.astro';

interface Props {
  aqi?: number; pm25?: number; pm1?: number; pm10?: number;
  feelsLike?: number; temperature?: number; humidity?: number;
  loading?: boolean;
}
const { aqi, pm25, pm1, pm10, feelsLike, temperature, humidity, loading = false } = Astro.props;
const fmt = (v: number | undefined, digits = 1) => (v == null ? '--' : v.toFixed(digits));
const particulates = [
  { icon: 'pm25', label: 'PM2.5', value: fmt(pm25) },
  { icon: 'pm1', label: 'PM1', value: fmt(pm1) },
  { icon: 'pm10', label: 'PM10', value: fmt(pm10) },
] as const;
const climate = [
  { icon: 'temperature', label: 'Temperature', value: fmt(temperature), unit: '°C' },
  { icon: 'humidity', label: 'Humidity', value: fmt(humidity, 0), unit: '%' },
] as const;
---
{loading ? (
  <div class="readings not-content" aria-hidden="true">
    <div class="cols">
      <div class="left"><div class="sk aqi-sk"></div><div class="sk"></div></div>
      <div class="right"><div class="sk"></div><div class="sk"></div></div>
    </div>
  </div>
) : (
  <div class="readings not-content">
    <div class="cols">
      <div class="left">
        <AqiBlock aqi={aqi} variant="tile" />
        <div class="card pm">
          {particulates.map((m) => (
            <div class="pm-col">
              <span class="pm-name"><span class="bubble sm"><Icon name={m.icon} size={14} /></span>{m.label}</span>
              <span class="value"><strong>{m.value}</strong> <small>µg/m³</small></span>
            </div>
          ))}
        </div>
      </div>
      <div class="right">
        <div class="card single">
          <div class="inline">
            <span class="bubble lg"><Icon name="feelsLike" size={22} /></span>
            <span class="stack"><span class="value"><strong class="big">{fmt(feelsLike)}</strong> <small>°C</small></span><small>Feels like</small></span>
          </div>
        </div>
        <div class="card pair">
          {climate.map((m) => (
            <div class="inline">
              <span class="bubble"><Icon name={m.icon} size={18} /></span>
              <span class="stack"><span class="value"><strong class="mid">{m.value}</strong> <small>{m.unit}</small></span><small>{m.label}</small></span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <DeviceFacts />
  </div>
)}

<style>
  .readings { display: grid; gap: 0.75rem; margin-block: 1.5rem; color: var(--oa-on-surface); }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .left, .right { display: grid; gap: 0.75rem; }
  .left { grid-template-rows: 3fr 1fr; }
  .right { grid-template-rows: 1fr 1fr; }
  .left > :global(.aqi) { display: flex; flex-direction: column; justify-content: center; padding-block: 1rem; }
  .card { background: var(--oa-raised); border: 1px solid var(--oa-outline-variant); border-radius: var(--oa-radius-xl); }
  .pm { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 0.625rem 0.25rem; }
  .pm-col { display: grid; justify-items: center; align-content: center; gap: 0.375rem; padding-inline: 0.5rem; }
  .pm-col + .pm-col, .inline + .inline { border-left: 1px solid var(--oa-outline-variant); }
  .pm-name { display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; color: var(--oa-on-surface-variant); }
  .single, .pair { display: grid; align-content: center; padding: 0.75rem 0.25rem; }
  .pair { grid-template-columns: 1fr 1fr; }
  .inline { display: flex; align-items: center; justify-content: center; gap: 0.75rem; padding-inline: 0.5rem; }
  .stack { display: grid; gap: 0.375rem; }
  .bubble { display: inline-grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--oa-secondary-container); color: var(--oa-on-secondary-container); }
  .bubble.sm { width: 1.75rem; height: 1.75rem; }
  .bubble.lg { width: 3rem; height: 3rem; }
  .value { line-height: 1; white-space: nowrap; }
  strong { font-weight: 500; font-size: 1rem; font-variant-numeric: tabular-nums; }
  strong.mid { font-size: 1.5rem; letter-spacing: -0.02em; }
  strong.big { font-size: 2.25rem; letter-spacing: -0.02em; }
  small { font-size: 0.72rem; color: var(--oa-on-surface-variant); }
  .sk { min-height: 5rem; border-radius: var(--oa-radius-xl); background: var(--oa-surface-container-highest); animation: pg-pulse var(--oa-duration-pulse) ease-in-out infinite alternate; }
  .right .sk { min-height: 0; }
  .aqi-sk { min-height: 0; border-radius: var(--oa-radius-sheet); }
  @keyframes pg-pulse { from { opacity: 1; } to { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .sk { animation: none; } }
  @media (max-width: 40rem) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .left, .right { grid-template-rows: none; }
    .aqi-sk, .right .sk { min-height: 5rem; }
  }
</style>
