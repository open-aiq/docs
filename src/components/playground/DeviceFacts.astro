---
// Status, sharing and placement inside a monitor: a row of bubbles under the
// web dashboard's readings, each with one word underneath and its explanation
// on hover or focus. Matches DeviceFacts.jsx.
import Icon from './Icon.astro';

interface Props { online?: boolean; seen?: string; isPublic?: boolean; outdoor?: boolean }
const { online = true, seen = 'Last seen Nov 9, 1:02 PM', isPublic = false, outdoor = false } = Astro.props;
type Row = { icon: 'online' | 'offline' | 'public' | 'private' | 'outdoor' | 'indoor'; label: string; description: string; tone?: boolean };
const rows: Row[] = [
  { icon: online ? 'online' : 'offline', label: online ? 'Online' : 'Offline', description: seen, tone: online },
  isPublic
    ? { icon: 'public', label: 'Public', description: 'Readings are shared publicly' }
    : { icon: 'private', label: 'Private', description: 'Readings are visible only to you' },
  outdoor
    ? { icon: 'outdoor', label: 'Outdoor', description: 'Sensor is installed outdoors' }
    : { icon: 'indoor', label: 'Indoor', description: 'Sensor is installed indoors' },
];
---
<ul class="facts not-content" aria-label="About this monitor">
  {rows.map((row) => (
    <li>
      <button type="button" class="fact" aria-label={`${row.label}. ${row.description}`}>
        <span class:list={['bubble', { online: row.tone }]}><Icon name={row.icon} size={20} /></span>
        <span class:list={['word', { online: row.tone }]}>{row.label}</span>
      </button>
      <span class="tip" aria-hidden="true">{row.description}</span>
    </li>
  ))}
</ul>

<style>
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; }
  li { position: relative; margin: 0; }
  .fact { display: grid; justify-items: center; gap: 0.375rem; padding: 0.25rem 0.375rem; border: 0; border-radius: 1rem; background: none; color: inherit; font: inherit; cursor: default; }
  .fact:focus-visible { outline: 3px solid color-mix(in srgb, var(--oa-primary) 50%, transparent); outline-offset: 2px; }
  .bubble { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--oa-secondary-container); color: var(--oa-on-secondary-container); }
  .bubble.online { color: var(--oa-online); }
  .word { font-size: 0.75rem; color: var(--oa-on-surface-variant); }
  .word.online { color: var(--oa-online); font-weight: 500; }
  .tip { position: absolute; bottom: calc(100% + 0.25rem); left: 50%; transform: translateX(-50%); z-index: 1; display: none; width: max-content; max-width: 14rem; padding: 0.4rem 0.75rem; border-radius: var(--oa-radius-sm); background: var(--oa-on-surface); color: var(--oa-surface); font-size: 0.75rem; line-height: 1.35; }
  li:hover .tip, li:focus-within .tip { display: block; }
</style>
