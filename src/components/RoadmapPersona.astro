---
// Small animated scenes for each roadmap audience. Decorative only. Motion is
// slow and gentle, and stops under prefers-reduced-motion.
interface Props {
  persona: 'dev' | 'maker' | 'everyone' | string
}
const { persona } = Astro.props
---

<svg class={`persona persona-${persona}`} viewBox="0 0 240 180" aria-hidden="true">
  <ellipse class="p-ground" cx="120" cy="160" rx="96" ry="10" />
  {
    persona === 'dev' && (
      <g>
        {/* Desk */}
        <rect class="p-wood" x="52" y="118" width="160" height="8" rx="4" />
        <path class="p-line" d="M66 126v32M198 126v32" />
        {/* Chair */}
        <path class="p-line" d="M30 96v34h34M40 130v28M58 130v28" />
        {/* Person */}
        <g class="p-breathe">
          <path class="p-shirt" d="M34 128c0-26 6-44 22-44s20 18 20 44z" />
          <circle class="p-skin" cx="56" cy="64" r="15" />
          <path class="p-hair" d="M41 62c0-11 7-17 15-17s16 5 16 15c-6-5-17-6-31 2z" />
          <g class="p-typing">
            <path class="p-arm" d="M66 96c10 8 22 14 40 16" />
          </g>
        </g>
        {/* Laptop */}
        <path class="p-ink-fill" d="M100 116h62l-6-6h-50z" />
        <path class="p-ink-fill" d="M146 110l12-46 6 2-11 44z" />
        {/* Dev board with a softly glowing LED */}
        <rect class="p-board" x="168" y="106" width="34" height="12" rx="2" />
        <rect class="p-chip" x="176" y="109" width="10" height="6" rx="1" />
        <circle class="p-led" cx="195" cy="112" r="2.5" />
        {/* Floating code bubble */}
        <g class="p-float">
          <rect class="p-bubble" x="112" y="22" width="56" height="30" rx="10" />
          <path class="p-code" d="M130 30l-7 7 7 7M150 30l7 7-7 7M143 29l-6 16" />
        </g>
      </g>
    )
  }
  {
    persona === 'maker' && (
      <g>
        {/* Workbench */}
        <rect class="p-wood" x="40" y="118" width="172" height="10" rx="4" />
        <path class="p-line" d="M54 128v30M198 128v30" />
        {/* PCB */}
        <rect class="p-board" x="118" y="106" width="74" height="12" rx="2" />
        <rect class="p-chip" x="128" y="102" width="14" height="6" rx="1" />
        <rect class="p-chip" x="150" y="103" width="8" height="5" rx="1" />
        <rect class="p-chip" x="166" y="101" width="18" height="7" rx="1" />
        {/* Person */}
        <g class="p-breathe">
          <path class="p-shirt" d="M48 120c0-26 8-46 26-46s22 20 22 46z" />
          <circle class="p-skin" cx="74" cy="54" r="15" />
          <path class="p-hair" d="M59 52c0-11 7-17 15-17s15 6 15 15c-8-3-18-3-30 2z" />
          <rect class="p-glasses" x="76" y="50" width="14" height="6" rx="3" />
          {/* Arm with soldering iron */}
          <path class="p-arm" d="M88 88c10 4 18 6 26 4" />
          <path class="p-iron" d="M112 90l26 14" />
          <path class="p-iron-tip" d="M138 104l4 2" />
        </g>
        {/* Gentle wisps of smoke */}
        <path class="p-smoke p-smoke-1" d="M142 98c-4-6 4-10 0-16s4-10 0-14" />
        <path class="p-smoke p-smoke-2" d="M148 98c-4-6 4-10 0-16" />
        {/* A soft twinkle */}
        <path class="p-spark" d="M160 82l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" />
      </g>
    )
  }
  {
    persona === 'everyone' && (
      <g>
        {/* Shelf with the finished monitor */}
        <rect class="p-wood" x="150" y="96" width="70" height="7" rx="3.5" />
        <rect class="p-device" x="162" y="62" width="40" height="34" rx="9" />
        <rect class="p-screen" x="169" y="69" width="26" height="16" rx="4" />
        <path class="p-smile" d="M177 76c2 3 8 3 10 0" />
        <circle class="p-eye" cx="178" cy="74" r="1.2" />
        <circle class="p-eye" cx="186" cy="74" r="1.2" />
        {/* Fresh-air waves */}
        <path class="p-wave p-wave-1" d="M208 70c6 6 6 14 0 20" />
        <path class="p-wave p-wave-2" d="M214 64c10 10 10 22 0 32" />
        {/* Plant */}
        <path class="p-pot" d="M196 158l4-24h22l4 24z" />
        <g class="p-sway">
          <path class="p-leaf" d="M211 134c-14-6-18-18-14-28 10 4 16 14 14 28z" />
          <path class="p-leaf" d="M211 134c10-10 22-12 28-6-6 8-18 10-28 6z" />
          <path class="p-leaf" d="M211 134c0-14 4-24 12-28 4 10 0 22-12 28z" />
        </g>
        {/* Armchair */}
        <path class="p-chair" d="M24 158v-46c0-12 8-18 18-18h52c10 0 18 6 18 18v46z" />
        <rect class="p-cushion" x="34" y="122" width="68" height="18" rx="8" />
        {/* Person, relaxed */}
        <g class="p-breathe">
          <path class="p-shirt" d="M46 124c0-24 8-40 24-40s22 16 22 40z" />
          <circle class="p-skin" cx="70" cy="66" r="15" />
          <path class="p-hair" d="M55 64c0-12 8-18 16-18s15 7 14 17c-4-8-16-10-30 1z" />
          <path class="p-arm" d="M86 100c8 2 14 0 18-6" />
        </g>
        {/* Mug with steam */}
        <rect class="p-mug" x="100" y="84" width="14" height="14" rx="3" />
        <path class="p-steam" d="M104 78c-3-4 3-6 0-10M110 78c-3-4 3-6 0-10" />
      </g>
    )
  }
</svg>

<style>
  .persona {
    --p-ink: #3b2716;
    --p-skin: #e8c39e;
    --p-hair: #4a3426;
    --p-shirt: var(--sl-color-accent);
    --p-wood: #c9a77c;
    --p-sage: var(--oa-sage, #6f7f5c);
    --p-sand: #f1e6d6;
    --p-ground: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    width: 100%;
    height: auto;
    overflow: visible;
  }
  :global(:root[data-theme='dark']) .persona {
    --p-ink: #f4e9da;
    --p-skin: #d9b18a;
    --p-hair: #2a1d10;
    --p-wood: #8a6a48;
    --p-sand: #3a2c1f;
    --p-ground: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
  }

  .p-ground { fill: var(--p-ground); }
  .p-wood { fill: var(--p-wood); }
  .p-line { fill: none; stroke: var(--p-wood); stroke-width: 4; stroke-linecap: round; }
  .p-shirt { fill: var(--p-shirt); }
  .p-skin { fill: var(--p-skin); }
  .p-hair { fill: var(--p-hair); }
  .p-arm { fill: none; stroke: var(--p-skin); stroke-width: 8; stroke-linecap: round; }
  .p-ink-fill { fill: var(--p-ink); opacity: 0.85; }
  .p-board { fill: var(--p-sage); }
  .p-chip { fill: var(--p-ink); opacity: 0.7; }
  .p-led { fill: #f2c46d; }
  .p-bubble { fill: var(--p-sand); stroke: var(--p-wood); stroke-width: 1.5; }
  .p-code { fill: none; stroke: var(--sl-color-accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .p-glasses { fill: none; stroke: var(--p-ink); stroke-width: 1.5; }
  .p-iron { stroke: var(--p-ink); stroke-width: 4; stroke-linecap: round; }
  .p-iron-tip { stroke: #c08457; stroke-width: 2.5; stroke-linecap: round; }
  .p-smoke,
  .p-steam,
  .p-wave { fill: none; stroke-linecap: round; stroke-width: 2; }
  .p-smoke,
  .p-steam { stroke: color-mix(in srgb, var(--p-ink) 35%, transparent); }
  .p-wave { stroke: var(--p-sage); }
  .p-spark { fill: #f2c46d; }
  .p-device { fill: var(--p-sand); stroke: var(--p-wood); stroke-width: 2; }
  .p-screen { fill: var(--p-sage); }
  .p-smile { fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; }
  .p-eye { fill: #fff; }
  .p-pot { fill: var(--p-wood); }
  .p-leaf { fill: var(--p-sage); }
  .p-chair { fill: color-mix(in srgb, var(--sl-color-accent) 55%, var(--p-wood)); }
  .p-cushion { fill: color-mix(in srgb, var(--sl-color-accent) 35%, var(--p-sand)); }
  .p-mug { fill: var(--p-sand); stroke: var(--p-wood); stroke-width: 2; }

  /* Slow, gentle motion. */
  .p-breathe { animation: p-breathe 6s ease-in-out infinite; transform-origin: 50% 100%; transform-box: fill-box; }
  .p-typing { animation: p-type 2.4s ease-in-out infinite; }
  .p-float { animation: p-float 7s ease-in-out infinite; }
  .p-led { animation: p-glow 4s ease-in-out infinite; }
  .p-smoke { animation: p-rise 6s ease-in-out infinite; }
  .p-smoke-2 { animation-delay: 3s; }
  .p-steam { animation: p-rise 5s ease-in-out infinite; }
  .p-spark { animation: p-twinkle 5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .p-wave { animation: p-glow 5s ease-in-out infinite; }
  .p-wave-2 { animation-delay: 1.2s; }
  .p-sway { animation: p-sway 8s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 100%; }

  @keyframes p-breathe { 50% { transform: scaleY(1.012); } }
  @keyframes p-type { 50% { transform: translateY(1.5px); } }
  @keyframes p-float { 50% { transform: translateY(-5px); } }
  @keyframes p-glow { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  @keyframes p-rise {
    0% { opacity: 0; transform: translateY(4px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes p-twinkle { 0%, 100% { opacity: 0.2; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1); } }
  @keyframes p-sway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }

  @media (prefers-reduced-motion: reduce) {
    .persona * { animation: none !important; }
  }
</style>
