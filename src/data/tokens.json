{
  "$description": "Sand & Sage design tokens: the one source for the docs site, the web dashboard and the mobile app. Edit here, then run `make tokens:sync` in docs/. Color roles use Material 3 names. Colors are #rrggbb or #rrggbbaa.",
  "color": {
    "light": {
      "primary": "#8a5d3b",
      "onPrimary": "#ffffff",
      "primaryContainer": "#f1e6d6",
      "onPrimaryContainer": "#3b2716",
      "secondary": "#6f7f5c",
      "onSecondary": "#ffffff",
      "secondaryContainer": "#e1e7d6",
      "onSecondaryContainer": "#2f3a24",
      "tertiary": "#8a6418",
      "tertiaryContainer": "#fbe7be",
      "onTertiaryContainer": "#3f2e05",
      "error": "#b3261e",
      "onError": "#ffffff",
      "surface": "#fbf8f3",
      "onSurface": "#3b2716",
      "onSurfaceVariant": "#6b5a49",
      "surfaceContainerLowest": "#ffffff",
      "surfaceContainerLow": "#f7f1e8",
      "surfaceContainer": "#f3ebdf",
      "surfaceContainerHigh": "#efe5d6",
      "surfaceContainerHighest": "#eadfcd",
      "outline": "#b3926b",
      "outlineVariant": "#e6d9c6"
    },
    "dark": {
      "primary": "#d6b88f",
      "onPrimary": "#3b2716",
      "primaryContainer": "#4a3826",
      "onPrimaryContainer": "#f1e6d6",
      "secondary": "#a3b18a",
      "onSecondary": "#1f2716",
      "secondaryContainer": "#3a4430",
      "onSecondaryContainer": "#e1e7d6",
      "tertiary": "#f2c46d",
      "tertiaryContainer": "#4d3b12",
      "onTertiaryContainer": "#fbe7be",
      "error": "#f2b8b5",
      "onError": "#601410",
      "surface": "#1b1611",
      "onSurface": "#f4e9da",
      "onSurfaceVariant": "#cdbca5",
      "surfaceContainerLowest": "#15110d",
      "surfaceContainerLow": "#211b15",
      "surfaceContainer": "#261f18",
      "surfaceContainerHigh": "#2e261d",
      "surfaceContainerHighest": "#372d23",
      "outline": "#8a6a48",
      "outlineVariant": "#3f3327"
    }
  },
  "brand": {
    "light": {
      "accent": "#8a5d3b",
      "sage": "#6f7f5c",
      "ink": "#3b2716",
      "sand": "#f1e6d6",
      "wood": "#c9a77c",
      "highlight": "#f2c46d",
      "ground": "#8a5d3b1a",
      "shadow": "#3b271614",
      "online": "#5f7a3f"
    },
    "dark": {
      "accent": "#d6b88f",
      "sage": "#a3b18a",
      "ink": "#f4e9da",
      "sand": "#3a2c1f",
      "wood": "#8a6a48",
      "highlight": "#f2c46d",
      "ground": "#d6b88f24",
      "shadow": "#00000040",
      "online": "#a3b18a"
    }
  },
  "aqi": {
    "bands": [
      { "max": 50, "label": "Good", "short": "Good", "bg": "#a8e05f", "fg": "#718b3a" },
      { "max": 100, "label": "Moderate", "short": "Moderate", "bg": "#fdd64b", "fg": "#a57f23" },
      {
        "max": 150,
        "label": "Slightly Unhealthy",
        "short": "Slightly Unhealthy",
        "bg": "#ff9b57",
        "fg": "#b25826"
      },
      { "max": 200, "label": "Unhealthy", "short": "Unhealthy", "bg": "#fe6a69", "fg": "#af2c3b" },
      {
        "max": 300,
        "label": "Very Unhealthy",
        "short": "Very Unhealthy",
        "bg": "#a97abc",
        "fg": "#634675"
      },
      { "max": null, "label": "Hazardous", "short": "Hazardous", "bg": "#a87383", "fg": "#683e51" }
    ],
    "unknown": { "label": "Unknown", "short": "No data", "bg": "#e5e5e5", "fg": "#525252" }
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "card": 24,
    "sheet": 28
  },
  "shadow": {
    "light": {
      "rest": "0 1px 2px rgb(59 39 22 / 5%), 0 10px 28px -14px rgb(59 39 22 / 24%)",
      "lift": "0 2px 4px rgb(59 39 22 / 6%), 0 26px 48px -20px rgb(59 39 22 / 34%)"
    },
    "dark": {
      "rest": "0 1px 2px rgb(0 0 0 / 30%), 0 12px 30px -14px rgb(0 0 0 / 60%)",
      "lift": "0 2px 4px rgb(0 0 0 / 35%), 0 28px 50px -20px rgb(0 0 0 / 75%)"
    }
  },
  "motion": {
    "duration": {
      "resize": 300,
      "lift": 500,
      "fade": 700,
      "chart": 800,
      "pulse": 1400,
      "float": 7000
    },
    "easing": {
      "calm": [0.22, 0.61, 0.36, 1]
    },
    "floatDistance": 4
  },
  "docs": {
    "light": { "textAccent": "#7a5233" },
    "dark": { "textAccent": "#e3c9a3" }
  }
}
